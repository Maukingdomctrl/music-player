<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon background, "Note in a Wheel" (Silver): brushed-silver metal
    as a smooth three-stop gradient with a soft highlight at the top left.
    No brush lines: they would turn to noise at launcher sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Metal. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="37.8"
                android:endY="108">
                <item android:offset="0" android:color="#FFFBFBFC" />
                <item android:offset="0.5" android:color="#FFD3D6DB" />
                <item android:offset="1" android:color="#FFEEF0F2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shine: white at 85 %, fading out. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30.2"
                android:centerY="16.2"
                android:gradientRadius="81">
                <item android:offset="0" android:color="#D9FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
