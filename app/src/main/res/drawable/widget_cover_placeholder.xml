<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while there is no cover: a note on a dark rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_cover_well" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:drawable="@drawable/ic_widget_note"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
